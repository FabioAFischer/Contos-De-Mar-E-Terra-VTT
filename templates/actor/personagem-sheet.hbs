<form class="cmet-character-sheet" autocomplete="off">
  <header class="cmet-sheet__header">
    <img class="cmet-sheet__portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img" title="{{localize 'CMET.Actions.ChangeImage'}}" aria-label="{{localize 'CMET.Actions.ChangeImage'}}: {{actor.name}}" />
    <div class="cmet-sheet__identity"><input class="cmet-sheet__name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'CMET.Fields.Name'}}" /><div class="cmet-sheet__identity-line">
      <label>{{localize "CMET.Fields.Race"}}<input name="system.identity.raca" value="{{actor.system.identity.raca}}" /></label><span class="cmet-identity-separator">•</span><label>{{localize "CMET.Fields.Age"}}<input name="system.identity.idade" type="number" min="0" value="{{actor.system.identity.idade}}" /></label>
    </div></div>
    <div class="cmet-progression"><label><span>{{localize "CMET.Fields.Level"}}</span><input name="system.progression.nivel" type="number" min="1" value="{{actor.system.progression.nivel}}" /></label><label><span>{{localize "CMET.Fields.Experience"}}</span><input name="system.progression.experiencia" type="number" min="0" value="{{actor.system.progression.experiencia}}" /></label><label><span>{{localize "CMET.Fields.Gyllen"}}</span><input name="system.currency.gyllen" type="number" min="0" value="{{actor.system.currency.gyllen}}" /></label></div>
  </header>
  <section class="cmet-resource-bar"><label class="cmet-resource"><span class="cmet-resource__label">{{resources.vida.label}}</span><span class="cmet-resource__value"><input name="system.resources.vida.value" type="number" min="0" value="{{resources.vida.value}}" /><span>/ {{resources.vida.max}}</span></span></label><label class="cmet-resource"><span class="cmet-resource__label">{{resources.mana.label}}</span><span class="cmet-resource__value"><input name="system.resources.mana.value" type="number" min="0" value="{{resources.mana.value}}" /><span>/ {{resources.mana.max}}</span></span></label><label class="cmet-resource"><span class="cmet-resource__label">{{resources.sanidade.label}}</span><span class="cmet-resource__value"><input name="system.resources.sanidade.value" type="number" min="0" value="{{resources.sanidade.value}}" /><span>/ {{resources.sanidade.max}}</span></span></label><label class="cmet-resource"><span class="cmet-resource__label">{{localize "CMET.Fields.Movement"}}</span><strong class="cmet-resource__value">{{resources.movimento}}</strong></label><label class="cmet-resource"><span class="cmet-resource__label">{{localize "CMET.Fields.Actions"}}</span><input class="cmet-resource__value" name="system.actions.max" type="number" min="0" value="{{resources.actions}}" /></label></section>
  <nav class="cmet-tabs" aria-label="{{localize 'CMET.Navigation.Label'}}"><button type="button" class="active" data-tab="atributos">{{localize "CMET.Navigation.Attributes"}}</button><button type="button" data-tab="equipamentos">{{localize "CMET.Navigation.Equipment"}}</button><button type="button" data-tab="habilidades">{{localize "CMET.Navigation.Abilities"}}</button><button type="button" data-tab="magias">{{localize "CMET.Navigation.Spells"}}</button><button type="button" data-tab="biografia">{{localize "CMET.Navigation.Biography"}}</button></nav>
  <main class="cmet-sheet__body">
    <div class="cmet-hands-config" data-tab-content="equipamentos" hidden><label>{{localize "CMET.Inventory.MainHand"}}<select name="system.hands.mainHand">{{#each weaponOptions}}<option value="{{id}}" {{#if (eq id ../hands.mainHand)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>{{localize "CMET.Inventory.OffHand"}}<select name="system.hands.offHand">{{#each weaponOptions}}<option value="{{id}}" {{#if (eq id ../hands.offHand)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><button type="button" data-action="combinedAttack">{{localize "CMET.Weapon.Actions.CombinedAttack"}}</button></div>
    <section data-tab-content="atributos" class="cmet-tab-content"><div class="cmet-attributes-grid">{{#each attributes}}<article class="cmet-attribute {{#if invalid}}is-invalid{{/if}}"><header class="cmet-attribute__header"><h2>{{label}}</h2><input name="system.attributes.{{key}}.value" type="number" min="0" value="{{value}}" aria-label="{{label}}" /></header><div class="cmet-pool"><span>{{skillsTotal}} / {{poolTotal}} {{localize "CMET.Fields.DistributedShort"}}</span><span class="{{#if invalid}}cmet-error{{/if}}">{{#if invalid}}{{localize "CMET.Fields.Exceeded"}} {{exceeded}}{{else}}{{#if available}}{{localize "CMET.Fields.Available"}}: {{remainingPoints}}{{else}}{{localize "CMET.Fields.AllDistributed"}}{{/if}}{{/if}}</span></div>{{#if invalid}}<p class="cmet-validation" role="alert">{{localize "CMET.Validation.OverPool"}}</p>{{/if}}<div class="cmet-skills">{{#each skills}}<div class="cmet-skill-row"><button type="button" class="cmet-skill-roll" data-action="roll-skill" data-skill-key="{{key}}" data-skill-label="{{label}}" title="{{localize 'CMET.Rolling.SkillTest'}}">{{label}}</button><input name="system.attributes.{{../key}}.skills.{{key}}" type="number" min="10" value="{{value}}" aria-label="{{label}}" /></div>{{/each}}</div></article>{{/each}}</div></section>
    <section data-tab-content="equipamentos" class="cmet-tab-content" hidden>{{> cmetEquippableItems title="CMET.Inventory.Weapons" createLabel="CMET.Inventory.CreateWeapon" emptyLabel="CMET.Inventory.NoWeapons" itemType="arma" items=armas equipped=true}}{{> cmetEquippableItems title="CMET.Inventory.ArmorsAndClothing" createLabel="CMET.Inventory.CreateArmor" emptyLabel="CMET.Inventory.NoArmors" itemType="armadura" items=armaduras equipped=true}}{{> cmetItems title="CMET.ItemTypes.equipamento" createLabel="CMET.Actions.Create" emptyLabel="CMET.NoItems" itemType="equipamento" items=equipamentos}}</section><section data-tab-content="habilidades" class="cmet-tab-content" hidden>{{> cmetItems title="CMET.Navigation.Abilities" createLabel="CMET.Ability.Create" emptyLabel="CMET.Ability.Empty" itemType="habilidade" items=habilidades}}</section><section data-tab-content="magias" class="cmet-tab-content" hidden>{{> cmetEquippableItems title="CMET.Navigation.Spells" createLabel="CMET.Spell.Create" emptyLabel="CMET.Spell.Empty" itemType="magia" items=magias equipped=false}}</section>
    <section data-tab-content="biografia" class="cmet-tab-content" hidden><div class="cmet-biography"><label>{{localize "CMET.Biography.History"}}<textarea name="system.biography.historia">{{actor.system.biography.historia}}</textarea></label><label>{{localize "CMET.Biography.Personality"}}<textarea name="system.biography.personalidade">{{actor.system.biography.personalidade}}</textarea></label><label>{{localize "CMET.Biography.Ideals"}}<textarea name="system.biography.ideais">{{actor.system.biography.ideais}}</textarea></label><label>{{localize "CMET.Biography.Faults"}}<textarea name="system.biography.defeitos">{{actor.system.biography.defeitos}}</textarea></label></div></section>
  </main>
</form>
{{#*inline "cmetEquippableItems"}}
  <section class="cmet-item-section">
    <div class="cmet-item-list-header"><h2>{{localize title}}</h2><button type="button" data-action="create-item" data-item-type="{{itemType}}">{{localize createLabel}}</button></div>
    <ul class="cmet-item-list">
      {{#each items}}
        <li class="cmet-item-row {{#if ../equipped}}cmet-equipped-item-row{{/if}}" data-item-id="{{id}}">
          <button type="button" class="cmet-item-row-image-button" data-action="open-item" data-item-id="{{id}}" title="{{localize 'CMET.Actions.Edit'}}: {{name}}" aria-label="{{localize 'CMET.Actions.Edit'}}: {{name}}"><img class="cmet-item-row-image" src="{{img}}" alt="" /></button>
          <div class="cmet-item-row-main">
            <button type="button" class="cmet-item-row-name" data-action="open-item" data-item-id="{{id}}">{{name}}</button>
            <div class="cmet-item-row-meta">{{firstMeta}}{{#if secondMeta}} • {{secondMeta}}{{/if}}</div>
            {{#if detailLabel}}<div class="cmet-item-row-meta">{{detailLabel}}</div>{{/if}}{{#if stateLabel}}<div class="cmet-item-row-meta">{{stateLabel}}</div>{{/if}}
          </div>
          {{#if ../equipped}}<span class="cmet-item-row-summary" title="{{sideLabel}}">{{sideLabel}}</span>
          <input class="cmet-item-equipped" type="checkbox" data-item-equipped aria-label="{{localize 'CMET.Weapon.Fields.Equipped'}}: {{name}}" title="{{localize 'CMET.Weapon.Fields.Equipped'}}" {{#if equipped}}checked{{/if}} />{{/if}}
          <div class="cmet-item-row-actions">
            {{#if canAttack}}<button type="button" class="cmet-item-attack" data-action="attackItem" data-item-id="{{id}}" title="{{localize 'CMET.CombatAttack.AttackWithWeapon'}} {{name}}" aria-label="{{localize 'CMET.CombatAttack.AttackWithWeapon'}} {{name}}" {{#if thrown}}disabled{{/if}}><i class="fas fa-swords" aria-hidden="true"></i></button>{{/if}}
            {{#if canThrow}}<button type="button" data-action="throwItem" data-item-id="{{id}}" title="{{localize 'CMET.Weapon.Actions.Throw'}}" aria-label="{{localize 'CMET.Weapon.Actions.Throw'}}"><i class="fas fa-share" aria-hidden="true"></i></button>{{/if}}
            {{#if canReload}}<button type="button" data-action="reloadItem" data-item-id="{{id}}" title="{{localize 'CMET.Weapon.Actions.Reload'}}" aria-label="{{localize 'CMET.Weapon.Actions.Reload'}}"><i class="fas fa-sync" aria-hidden="true"></i></button>{{/if}}
            {{#if canRecover}}<button type="button" data-action="recoverItem" data-item-id="{{id}}" title="{{localize 'CMET.Weapon.Actions.Recover'}}" aria-label="{{localize 'CMET.Weapon.Actions.Recover'}}"><i class="fas fa-hand-paper" aria-hidden="true"></i></button>{{/if}}
            {{#if canRoll}}<button type="button" class="cmet-item-roll" data-action="rollItemSkill" data-item-id="{{id}}" title="{{localize 'CMET.Actions.Roll'}}: {{rollSkillLabel}}" aria-label="{{localize 'CMET.Actions.Roll'}}: {{rollSkillLabel}}"><i class="fas fa-dice-d20" aria-hidden="true"></i></button>{{/if}}
            <button type="button" data-action="open-item" data-item-id="{{id}}" title="{{localize 'CMET.Actions.Edit'}}" aria-label="{{localize 'CMET.Actions.Edit'}}: {{name}}"><i class="fas fa-pen" aria-hidden="true"></i></button>
            <button type="button" data-action="delete-item" data-item-id="{{id}}" title="{{localize 'CMET.Actions.Remove'}}" aria-label="{{localize 'CMET.Actions.Remove'}}: {{name}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
          </div>
        </li>
      {{else}}<li class="cmet-items__empty">{{localize emptyLabel}}</li>{{/each}}
    </ul>
  </section>
{{/inline}}
{{#*inline "cmetItems"}}<div class="cmet-item-section"><div class="cmet-item-list-header"><h2>{{localize title}}</h2><button type="button" data-action="create-item" data-item-type="{{itemType}}">{{localize createLabel}}</button></div><ul class="cmet-item-list">{{#each items}}<li class="cmet-item-row" data-item-id="{{id}}"><button type="button" class="cmet-item-row-image-button" data-action="open-item" data-item-id="{{id}}" title="{{localize 'CMET.Actions.Edit'}}: {{name}}" aria-label="{{localize 'CMET.Actions.Edit'}}: {{name}}"><img class="cmet-item-row-image" src="{{img}}" alt="" /></button><div class="cmet-item-row-main"><button type="button" class="cmet-item-row-name" data-action="open-item" data-item-id="{{id}}">{{name}}</button>{{#if firstMeta}}<div class="cmet-item-row-meta">{{firstMeta}}{{#if secondMeta}} • {{secondMeta}}{{/if}}</div>{{/if}}{{#if detailLabel}}<div class="cmet-item-row-meta">{{detailLabel}}</div>{{/if}}</div><div class="cmet-item-row-actions">{{#if canRoll}}<button type="button" class="cmet-item-roll" data-action="rollItemSkill" data-item-id="{{id}}" title="{{localize 'CMET.Actions.Roll'}}: {{rollSkillLabel}}" aria-label="{{localize 'CMET.Actions.Roll'}}: {{rollSkillLabel}}"><i class="fas fa-dice-d20" aria-hidden="true"></i></button>{{/if}}<button type="button" data-action="open-item" data-item-id="{{id}}" title="{{localize 'CMET.Actions.Edit'}}" aria-label="{{localize 'CMET.Actions.Edit'}}: {{name}}"><i class="fas fa-pen" aria-hidden="true"></i></button><button type="button" data-action="delete-item" data-item-id="{{id}}" title="{{localize 'CMET.Actions.Remove'}}" aria-label="{{localize 'CMET.Actions.Remove'}}: {{name}}"><i class="fas fa-trash" aria-hidden="true"></i></button></div></li>{{else}}<li class="cmet-items__empty">{{localize emptyLabel}}</li>{{/each}}</ul></div>{{/inline}}
