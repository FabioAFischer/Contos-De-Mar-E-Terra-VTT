<form class="cmet-configured-item-sheet" autocomplete="off">
  <div class="cmet-config-chrome">
    <header class="cmet-config-header">
      <img class="cmet-config-header__image" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img" title="{{localize 'CMET.Actions.ChangeImage'}}" aria-label="{{localize 'CMET.Actions.ChangeImage'}}: {{item.name}}" />
      <div class="cmet-config-header__identity">
        <input class="cmet-config-header__name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'CMET.Fields.Name'}}" />
        <label>{{localize "CMET.Spell.Fields.School"}}<select name="system.school"><option value="">{{localize "CMET.Spell.Fields.NoSchool"}}</option>{{#each schools}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label>{{localize "CMET.Spell.Fields.ManaCost"}}<input name="system.manaCost" type="number" min="0" step="1" value="{{system.manaCost}}" /></label>
      </div>
    </header>
    <nav class="cmet-config-tabs tabs" data-group="primary" aria-label="{{localize 'CMET.Navigation.Label'}}">
      <button type="button" class="item {{tabs.configuracao.cssClass}}" data-group="primary" data-tab="configuracao">{{localize "CMET.Weapon.Tabs.Configuration"}}</button>
      <button type="button" class="item {{tabs.descricao.cssClass}}" data-group="primary" data-tab="descricao">{{localize "CMET.Weapon.Tabs.Description"}}</button>
    </nav>
  </div>

  <section class="tab cmet-config-tab {{tabs.configuracao.cssClass}}" data-group="primary" data-tab="configuracao">
    <section class="cmet-config-section cmet-spell-fields">
      <label>{{localize "CMET.Spell.Fields.Target"}}<input name="system.target" type="text" value="{{system.target}}" /></label>
      <label>{{localize "CMET.Spell.Fields.Range"}}<input name="system.range" type="text" value="{{system.range}}" /></label>
      <label>{{localize "CMET.Spell.Fields.Concentration"}}<input name="system.concentration" type="text" value="{{system.concentration}}" /></label>
      <label>{{localize "CMET.Spell.Fields.Duration"}}<input name="system.duration" type="text" value="{{system.duration}}" /></label>
    </section>
    <section class="cmet-config-section cmet-spell-casting">
      <h2>{{localize "CMET.Spell.Fields.Casting"}}</h2>
      <div class="cmet-spell-components">
        <label class="cmet-config-check"><input name="system.casting.verbal" type="checkbox" {{#if system.casting.verbal}}checked{{/if}} />{{localize "CMET.Spell.Fields.Verbal"}}</label>
        <label class="cmet-config-check"><input name="system.casting.somatic" type="checkbox" {{#if system.casting.somatic}}checked{{/if}} />{{localize "CMET.Spell.Fields.Somatic"}}</label>
        <label class="cmet-config-check"><input name="system.casting.material" type="checkbox" data-parameter-toggle {{#if system.casting.material}}checked{{/if}} />{{localize "CMET.Spell.Fields.Material"}}</label>
      </div>
      <label>{{localize "CMET.Spell.Fields.CastingDetails"}}<input name="system.casting.details" type="text" value="{{system.casting.details}}" /></label>
      {{#if system.casting.material}}<label>{{localize "CMET.Spell.Fields.MaterialDescription"}}<input name="system.casting.materialDescription" type="text" value="{{system.casting.materialDescription}}" /></label>{{/if}}
    </section>
  </section>

  <section class="tab cmet-config-tab cmet-config-tab--description cmet-spell-description {{tabs.descricao.cssClass}}" data-group="primary" data-tab="descricao">
    <label>{{localize "CMET.Spell.Fields.Description"}}<textarea name="system.description">{{system.description}}</textarea></label>
    <label>{{localize "CMET.Spell.Fields.Effect"}}<textarea name="system.effect">{{system.effect}}</textarea></label>
    <label>{{localize "CMET.Spell.Fields.Upgrade"}}<textarea name="system.upgrade">{{system.upgrade}}</textarea></label>
  </section>
</form>
