<form class="cmet-da-ability-form" autocomplete="off">
  <header class="cmet-da-header">
    {{#if isEditMode}}
      <img class="cmet-da-header__image" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img" title="{{localize 'CMET.Actions.ChangeImage'}}" />
    {{else}}
      <img class="cmet-da-header__image" src="{{item.img}}" alt="{{item.name}}" />
    {{/if}}
    <div class="cmet-da-header__identity">
      {{#if isEditMode}}<input class="cmet-da-header__name" name="name" type="text" value="{{item.name}}" />{{else}}<h1>{{item.name}}</h1>{{/if}}
      <div class="cmet-da-header__meta"><span>{{localize "CMET.AbilityDa.Fields.ActivationType"}}: {{itemActivationLabel}}</span><span>{{item.system.origin}}</span><span>{{item.system.category}}</span></div>
    </div>
    <button type="button" class="cmet-da-mode-button" data-da-action="toggle-mode" {{#unless isOwner}}disabled{{/unless}}>{{#if isEditMode}}{{localize "CMET.AbilityDa.Actions.View"}}{{else}}{{localize "CMET.AbilityDa.Actions.Edit"}}{{/if}}</button>
  </header>

  <nav class="cmet-config-tabs cmet-da-tabs tabs" data-group="primary" aria-label="{{localize 'CMET.Navigation.Label'}}">
    <button type="button" class="item {{tabs.resumo.cssClass}}" data-group="primary" data-tab="resumo">{{localize "CMET.AbilityDa.Tabs.Summary"}}</button>
    <button type="button" class="item {{tabs.mecanica.cssClass}}" data-group="primary" data-tab="mecanica">{{localize "CMET.AbilityDa.Tabs.Mechanics"}}</button>
    <button type="button" class="item {{tabs.narrativa.cssClass}}" data-group="primary" data-tab="narrativa">{{localize "CMET.AbilityDa.Tabs.Narrative"}}</button>
    <button type="button" class="item {{tabs.avancado.cssClass}}" data-group="primary" data-tab="avancado">{{localize "CMET.AbilityDa.Tabs.Advanced"}}</button>
  </nav>

  <section class="tab cmet-da-tab {{tabs.resumo.cssClass}}" data-group="primary" data-tab="resumo">
    <div class="cmet-da-summary-grid">
      <section class="cmet-da-panel cmet-da-summary-intro">
        <span class="cmet-da-eyebrow">{{localize "CMET.AbilityDa.Tabs.Summary"}}</span>
        <h2>{{item.name}}</h2>
        <p>{{#if item.system.description}}{{item.system.description}}{{else}}{{localize "CMET.AbilityDa.Summary.NoDescription"}}{{/if}}</p>
        <div class="cmet-da-facts"><span>{{localize "CMET.AbilityDa.Fields.Origin"}}<strong>{{item.system.origin}}</strong></span><span>{{localize "CMET.AbilityDa.Fields.Category"}}<strong>{{item.system.category}}</strong></span><span>{{localize "CMET.AbilityDa.Fields.AssociatedCharacter"}}<strong>{{item.system.associatedCharacter}}</strong></span></div>
        {{#if isEditMode}}<div class="cmet-da-form-grid cmet-da-summary-fields"><label>{{localize "CMET.AbilityDa.Fields.Origin"}}<input name="system.origin" value="{{item.system.origin}}" /></label><label>{{localize "CMET.AbilityDa.Fields.Category"}}<input name="system.category" value="{{item.system.category}}" /></label><label>{{localize "CMET.AbilityDa.Fields.AssociatedCharacter"}}<input name="system.associatedCharacter" value="{{item.system.associatedCharacter}}" placeholder="{{localize 'CMET.AbilityDa.Fields.CharacterPlaceholder'}}" /></label><label>{{localize "CMET.AbilityDa.Fields.ActivationType"}}<select name="system.activationType"><option value="passiva" {{#if (eq item.system.activationType "passiva")}}selected{{/if}}>{{localize "CMET.AbilityDa.Activation.Passive"}}</option><option value="ativa" {{#if (eq item.system.activationType "ativa")}}selected{{/if}}>{{localize "CMET.AbilityDa.Activation.Active"}}</option><option value="reativa" {{#if (eq item.system.activationType "reativa")}}selected{{/if}}>{{localize "CMET.AbilityDa.Activation.Reactive"}}</option></select></label></div>{{/if}}
      </section>
      <section class="cmet-da-panel">
        <h2>{{localize "CMET.AbilityDa.Summary.Effects"}}</h2>
        {{#each summaryEffects}}
          <article class="cmet-da-summary-card"><header><strong>{{name}}</strong><span>{{activationLabel}}</span></header><p>{{summary}}</p><div class="cmet-da-summary-lines"><span>{{localize "CMET.AbilityDa.Summary.Cost"}}: {{costLabel}}</span><span>{{localize "CMET.AbilityDa.Summary.Duration"}}: {{durationLabel}}</span><span>{{localize "CMET.AbilityDa.Summary.Automation"}}: {{automaticCount}} {{localize "CMET.AbilityDa.Summary.Automatic"}}{{#if manualCount}}, {{manualCount}} {{localize "CMET.AbilityDa.Summary.Manual"}}{{/if}}</span></div></article>
        {{else}}<p class="cmet-da-empty">{{localize "CMET.AbilityDa.EmptyEffects"}}</p>{{/each}}
      </section>
    </div>
  </section>

  <section class="tab cmet-da-tab {{tabs.mecanica.cssClass}}" data-group="primary" data-tab="mecanica">
    <div class="cmet-da-section-heading"><div><span class="cmet-da-eyebrow">{{localize "CMET.AbilityDa.Tabs.Mechanics"}}</span><h2>{{localize "CMET.AbilityDa.Fields.Effects"}}</h2></div>{{#if isEditMode}}<button type="button" data-da-action="add">{{localize "CMET.AbilityDa.Actions.AddEffect"}}</button>{{/if}}</div>
    {{#each effects}}
      <article class="cmet-da-effect-card" data-effect-index="{{@index}}">
        <header class="cmet-da-effect-card__header"><button type="button" class="cmet-da-effect-card__toggle" data-da-action="toggle-effect" data-effect-id="{{id}}" aria-expanded="{{isOpen}}"><span class="cmet-da-chevron">{{#if isOpen}}▾{{else}}▸{{/if}}</span><span><strong>{{#if name}}{{name}}{{else}}{{localize "CMET.AbilityDa.Actions.UntitledEffect"}}{{/if}}</strong><small>{{activationLabel}} · {{activeLabel}}</small></span></button>{{#if isEditMode}}<div class="cmet-da-card-actions"><button type="button" data-da-action="up">↑</button><button type="button" data-da-action="down">↓</button><button type="button" data-da-action="duplicate">＋</button><button type="button" data-da-action="remove">×</button></div>{{/if}}</header>
        <div class="cmet-da-effect-card__summary"><span>{{summary}}</span><span>{{automaticCount}} {{localize "CMET.AbilityDa.Summary.Automatic"}}{{#if manualCount}} · {{manualCount}} {{localize "CMET.AbilityDa.Summary.Manual"}}{{/if}}</span></div>
        {{#if isOpen}}
          {{#if isEditMode}}
            <div class="cmet-da-editor">
              <details open><summary>{{localize "CMET.AbilityDa.Editor.Activation"}}</summary><div class="cmet-da-form-grid"><label>{{localize "CMET.Fields.Name"}}<input name="system.effects.{{@index}}.name" value="{{name}}" /></label><label>{{localize "CMET.AbilityDa.Fields.ActivationType"}}<select name="system.effects.{{@index}}.activationType"><option value="passiva" {{#if (eq activationType "passiva")}}selected{{/if}}>{{localize "CMET.AbilityDa.Activation.Passive"}}</option><option value="ativa" {{#if (eq activationType "ativa")}}selected{{/if}}>{{localize "CMET.AbilityDa.Activation.Active"}}</option><option value="reativa" {{#if (eq activationType "reativa")}}selected{{/if}}>{{localize "CMET.AbilityDa.Activation.Reactive"}}</option></select></label><label>{{localize "CMET.AbilityDa.Fields.Trigger"}}<select name="system.effects.{{@index}}.trigger.event">{{#each ../triggerEvents}}<option value="{{key}}" {{#if (eq ../trigger.event key)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select></label><label>{{localize "CMET.AbilityDa.Fields.TriggerPhase"}}<input name="system.effects.{{@index}}.trigger.phase" value="{{trigger.phase}}" /></label><label>{{localize "CMET.AbilityDa.Fields.OncePolicy"}}<input name="system.effects.{{@index}}.trigger.oncePolicy" value="{{trigger.oncePolicy}}" /></label><label class="cmet-da-check"><input type="checkbox" name="system.effects.{{@index}}.enabled" {{#if enabled}}checked{{/if}} />{{localize "CMET.AbilityDa.Fields.Enabled"}}</label><label class="cmet-da-wide">{{localize "CMET.AbilityDa.Fields.Summary"}}<input name="system.effects.{{@index}}.summary" value="{{summary}}" /></label></div></details>
              <details><summary>{{localize "CMET.AbilityDa.Editor.Requirements"}}</summary><div class="cmet-da-editor-list">{{#each conditions}}<div class="cmet-da-condition-row">{{#if (eq key "logic")}}<strong>{{localize "CMET.AbilityDa.ConditionFields.Or"}}</strong><input type="hidden" name="system.effects.{{@../index}}.conditions.{{@index}}.key" value="{{key}}" /><input type="hidden" name="system.effects.{{@../index}}.conditions.{{@index}}.operator" value="{{operator}}" /><input name="system.effects.{{@../index}}.conditions.{{@index}}.value" value="{{value}}" />{{else}}<select name="system.effects.{{@../index}}.conditions.{{@index}}.key"><option value="target.level" {{#if (eq key "target.level")}}selected{{/if}}>{{localize "CMET.AbilityDa.ConditionFields.TargetLevel"}}</option><option value="target.size" {{#if (eq key "target.size")}}selected{{/if}}>{{localize "CMET.AbilityDa.ConditionFields.TargetSize"}}</option><option value="actor.level" {{#if (eq key "actor.level")}}selected{{/if}}>{{localize "CMET.AbilityDa.ConditionFields.ActorLevel"}}</option><option value="actor.size" {{#if (eq key "actor.size")}}selected{{/if}}>{{localize "CMET.AbilityDa.ConditionFields.ActorSize"}}</option></select><select name="system.effects.{{@../index}}.conditions.{{@index}}.operator"><option value="equals" {{#if (eq operator "equals")}}selected{{/if}}>{{localize "CMET.AbilityDa.Operators.Equals"}}</option><option value="notEquals" {{#if (eq operator "notEquals")}}selected{{/if}}>{{localize "CMET.AbilityDa.Operators.NotEquals"}}</option><option value="greaterThan" {{#if (eq operator "greaterThan")}}selected{{/if}}>{{localize "CMET.AbilityDa.Operators.GreaterThan"}}</option><option value="greaterThanOrEqual" {{#if (eq operator "greaterThanOrEqual")}}selected{{/if}}>{{localize "CMET.AbilityDa.Operators.GreaterThanOrEqual"}}</option><option value="lessThan" {{#if (eq operator "lessThan")}}selected{{/if}}>{{localize "CMET.AbilityDa.Operators.LessThan"}}</option><option value="lessThanOrEqual" {{#if (eq operator "lessThanOrEqual")}}selected{{/if}}>{{localize "CMET.AbilityDa.Operators.LessThanOrEqual"}}</option></select><input name="system.effects.{{@../index}}.conditions.{{@index}}.value" value="{{value}}" />{{/if}}<button type="button" data-da-action="remove-condition" data-effect-id="{{@index}}">×</button></div>{{else}}<p class="cmet-da-empty">{{localize "CMET.AbilityDa.EmptyConditions"}}</p>{{/each}}<button type="button" class="cmet-da-secondary" data-da-action="add-condition">{{localize "CMET.AbilityDa.Actions.AddCondition"}}</button></div></details>
              <details><summary>{{localize "CMET.AbilityDa.Editor.CostsTests"}}</summary><div class="cmet-da-editor-list"><h4>{{localize "CMET.AbilityDa.Costs.Title"}}</h4>{{#each costs}}<div class="cmet-da-cost-row"><select name="system.effects.{{@../index}}.costs.{{@index}}.type">{{#each ../../costTypes}}<option value="{{key}}" {{#if (eq ../type key)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select><input type="number" min="0" name="system.effects.{{@../index}}.costs.{{@index}}.amount" value="{{amount}}" /><select name="system.effects.{{@../index}}.costs.{{@index}}.timing">{{#each ../../costTimings}}<option value="{{key}}" {{#if (eq ../timing key)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select><button type="button" data-da-action="remove-cost" data-effect-id="{{@index}}">×</button></div>{{else}}<p class="cmet-da-empty">{{localize "CMET.AbilityDa.Summary.NoCost"}}</p>{{/each}}<button type="button" class="cmet-da-secondary" data-da-action="add-cost">{{localize "CMET.AbilityDa.Actions.AddCost"}}</button><h4>{{localize "CMET.AbilityDa.Tests.Title"}}</h4>{{#each rolls}}<div class="cmet-da-roll-row"><select name="system.effects.{{@../index}}.rolls.{{@index}}.type"><option value="manual" {{#if (eq type "manual")}}selected{{/if}}>{{localize "CMET.AbilityDa.Tests.Manual"}}</option><option value="skill" {{#if (eq type "skill")}}selected{{/if}}>{{localize "CMET.AbilityDa.Tests.Skill"}}</option><option value="resistance" {{#if (eq type "resistance")}}selected{{/if}}>{{localize "CMET.AbilityDa.Tests.Resistance"}}</option><option value="opposed" {{#if (eq type "opposed")}}selected{{/if}}>{{localize "CMET.AbilityDa.Tests.Opposed"}}</option></select><input name="system.effects.{{@../index}}.rolls.{{@index}}.skillKey" value="{{skillKey}}" placeholder="{{localize 'CMET.AbilityDa.Fields.SkillKey'}}" /><input type="number" name="system.effects.{{@../index}}.rolls.{{@index}}.difficulty" value="{{difficulty}}" /><button type="button" data-da-action="remove-test" data-effect-id="{{@index}}">×</button></div>{{/each}}<button type="button" class="cmet-da-secondary" data-da-action="add-test">{{localize "CMET.AbilityDa.Actions.AddTest"}}</button></div></details>
              <details><summary>{{localize "CMET.AbilityDa.Editor.Targets"}}</summary><div class="cmet-da-form-grid"><label>{{localize "CMET.AbilityDa.Targets.Relation"}}<input name="system.effects.{{@index}}.targets.relation" value="{{targets.relation}}" /></label><label>{{localize "CMET.AbilityDa.Targets.Count"}}<input type="number" min="0" name="system.effects.{{@index}}.targets.count" value="{{targets.count}}" /></label><label>{{localize "CMET.AbilityDa.Targets.Range"}}<input type="number" min="0" name="system.effects.{{@index}}.targets.range" value="{{targets.range}}" /></label><label class="cmet-da-check"><input type="checkbox" name="system.effects.{{@index}}.targets.requiresSelection" {{#if targets.requiresSelection}}checked{{/if}} />{{localize "CMET.AbilityDa.Targets.RequiresSelection"}}</label></div></details>
              <details><summary>{{localize "CMET.AbilityDa.Editor.Operations"}}</summary><div class="cmet-da-editor-list">{{#each operations}}<div class="cmet-da-operation-card"><div class="cmet-da-operation-head"><select name="system.effects.{{@../index}}.operations.{{@index}}.type"><option value="manual" {{#if (eq type "manual")}}selected{{/if}}>{{localize "CMET.AbilityDa.Operations.Manual"}}</option>{{#each ../../operationTypes}}<option value="{{key}}" {{#if (eq ../type key)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select><span>{{#if manual}}{{localize "CMET.AbilityDa.Summary.Manual"}}{{else}}{{localize "CMET.AbilityDa.Summary.Automatic"}}{{/if}}</span><button type="button" data-da-action="remove-operation" data-effect-id="{{@index}}">×</button></div>{{#if (eq type "manual")}}<label>{{localize "CMET.AbilityDa.Operations.Instructions"}}<textarea name="system.effects.{{@../index}}.operations.{{@index}}.description">{{description}}</textarea></label>{{else if (eq type "resource")}}<div class="cmet-da-operation-fields"><label>{{localize "CMET.AbilityDa.Operations.Resource"}}<input name="system.effects.{{@../index}}.operations.{{@index}}.resourceId" value="{{resourceId}}" /></label><label>{{localize "CMET.AbilityDa.Operations.Amount"}}<input type="number" name="system.effects.{{@../index}}.operations.{{@index}}.amount" value="{{amount}}" /></label></div>{{else if (eq type "heal")}}<div class="cmet-da-operation-fields"><label>{{localize "CMET.AbilityDa.Operations.Formula"}}<input name="system.effects.{{@../index}}.operations.{{@index}}.formula" value="{{formula}}" /></label><label>{{localize "CMET.AbilityDa.Operations.Amount"}}<input type="number" name="system.effects.{{@../index}}.operations.{{@index}}.amount" value="{{amount}}" /></label></div>{{else if (eq type "damage")}}<div class="cmet-da-operation-fields"><label>{{localize "CMET.AbilityDa.Operations.Formula"}}<input name="system.effects.{{@../index}}.operations.{{@index}}.formula" value="{{formula}}" /></label><label>{{localize "CMET.AbilityDa.Operations.Amount"}}<input type="number" name="system.effects.{{@../index}}.operations.{{@index}}.amount" value="{{amount}}" /></label></div>{{else if (eq type "skillModifier")}}<div class="cmet-da-operation-fields"><label>{{localize "CMET.AbilityDa.Operations.Skill"}}<input name="system.effects.{{@../index}}.operations.{{@index}}.skillKey" value="{{skillKey}}" /></label><label>{{localize "CMET.AbilityDa.Operations.Amount"}}<input type="number" name="system.effects.{{@../index}}.operations.{{@index}}.amount" value="{{amount}}" /></label></div>{{else if (eq type "weaponGrip")}}<label>{{localize "CMET.AbilityDa.Operations.Characteristic"}}<input name="system.effects.{{@../index}}.operations.{{@index}}.conditionKey" value="{{conditionKey}}" /></label>{{else if (eq type "armorBonus")}}<div class="cmet-da-operation-fields"><label>{{localize "CMET.AbilityDa.Operations.Characteristic"}}<input name="system.effects.{{@../index}}.operations.{{@index}}.conditionKey" value="{{conditionKey}}" /></label><label>{{localize "CMET.AbilityDa.Operations.Amount"}}<input type="number" name="system.effects.{{@../index}}.operations.{{@index}}.amount" value="{{amount}}" /></label></div>{{else if (eq type "sizeIncrease")}}<label>{{localize "CMET.AbilityDa.Operations.Stages"}}<input type="number" name="system.effects.{{@../index}}.operations.{{@index}}.amount" value="{{amount}}" /></label>{{else if (eq type "conditionAdd")}}<label>{{localize "CMET.AbilityDa.Operations.Condition"}}<input name="system.effects.{{@../index}}.operations.{{@index}}.conditionKey" value="{{conditionKey}}" /></label>{{else if (eq type "conditionRemove")}}<label>{{localize "CMET.AbilityDa.Operations.Condition"}}<input name="system.effects.{{@../index}}.operations.{{@index}}.conditionKey" value="{{conditionKey}}" /></label>{{/if}}</div>{{else}}<p class="cmet-da-empty">{{localize "CMET.AbilityDa.Summary.NoOperations"}}</p>{{/each}}<button type="button" class="cmet-da-secondary" data-da-action="add-operation">{{localize "CMET.AbilityDa.Actions.AddOperation"}}</button></div></details>
              <details><summary>{{localize "CMET.AbilityDa.Editor.Persistence"}}</summary><div class="cmet-da-form-grid"><label>{{localize "CMET.AbilityDa.Duration.Title"}}<select name="system.effects.{{@index}}.duration.type"><option value="instant" {{#if (eq duration.type "instant")}}selected{{/if}}>{{localize "CMET.AbilityDa.Duration.Instant"}}</option><option value="turns" {{#if (eq duration.type "turns")}}selected{{/if}}>{{localize "CMET.AbilityDa.Duration.Turns"}}</option><option value="rounds" {{#if (eq duration.type "rounds")}}selected{{/if}}>{{localize "CMET.AbilityDa.Duration.Rounds"}}</option><option value="condition" {{#if (eq duration.type "condition")}}selected{{/if}}>{{localize "CMET.AbilityDa.Duration.Condition"}}</option><option value="permanent" {{#if (eq duration.type "permanent")}}selected{{/if}}>{{localize "CMET.AbilityDa.Duration.Permanent"}}</option></select></label><label>{{localize "CMET.AbilityDa.Duration.Amount"}}<input type="number" min="0" name="system.effects.{{@index}}.duration.amount" value="{{duration.amount}}" /></label><label class="cmet-da-wide">{{localize "CMET.AbilityDa.Duration.Reference"}}<input name="system.effects.{{@index}}.duration.reference" value="{{duration.reference}}" /></label><label>{{localize "CMET.AbilityDa.Limits.Title"}}<select name="system.effects.{{@index}}.limits.type"><option value="none" {{#if (eq limits.type "none")}}selected{{/if}}>{{localize "CMET.AbilityDa.Limits.None"}}</option><option value="turn" {{#if (eq limits.type "turn")}}selected{{/if}}>{{localize "CMET.AbilityDa.Limits.Turn"}}</option><option value="combat" {{#if (eq limits.type "combat")}}selected{{/if}}>{{localize "CMET.AbilityDa.Limits.Combat"}}</option><option value="day" {{#if (eq limits.type "day")}}selected{{/if}}>{{localize "CMET.AbilityDa.Limits.Day"}}</option></select></label><label>{{localize "CMET.AbilityDa.Limits.Maximum"}}<input type="number" min="0" name="system.effects.{{@index}}.limits.maximum" value="{{limits.maximum}}" /></label></div></details>
              <details><summary>{{localize "CMET.AbilityDa.Editor.Branches"}}</summary><div class="cmet-da-editor-list">{{#each branches}}<div class="cmet-da-cost-row"><input name="system.effects.{{@../index}}.branches.{{@index}}.name" value="{{name}}" placeholder="{{localize 'CMET.AbilityDa.Branches.Name'}}" /><select name="system.effects.{{@../index}}.branches.{{@index}}.selection"><option value="exclusive" {{#if (eq selection "exclusive")}}selected{{/if}}>{{localize "CMET.AbilityDa.Branches.Exclusive"}}</option><option value="multiple" {{#if (eq selection "multiple")}}selected{{/if}}>{{localize "CMET.AbilityDa.Branches.Multiple"}}</option><option value="sequence" {{#if (eq selection "sequence")}}selected{{/if}}>{{localize "CMET.AbilityDa.Branches.Sequence"}}</option></select><input name="system.effects.{{@../index}}.branches.{{@index}}.condition" value="{{condition}}" /><button type="button" data-da-action="remove-branch" data-effect-id="{{@index}}">×</button></div>{{else}}<p class="cmet-da-empty">{{localize "CMET.AbilityDa.Summary.None"}}</p>{{/each}}<button type="button" class="cmet-da-secondary" data-da-action="add-branch">{{localize "CMET.AbilityDa.Actions.AddBranch"}}</button></div></details>
            </div>
          {{else}}
            <div class="cmet-da-readonly-groups"><div><strong>{{localize "CMET.AbilityDa.Editor.Requirements"}}</strong><p>{{#each conditionSummaries}}{{this}}{{#unless @last}} · {{/unless}}{{else}}{{localize "CMET.AbilityDa.Summary.None"}}{{/each}}</p></div><div><strong>{{localize "CMET.AbilityDa.Editor.CostsTests"}}</strong><p>{{costLabel}} · {{testLabel}}</p></div><div><strong>{{localize "CMET.AbilityDa.Editor.Operations"}}</strong><p>{{#each operationSummaries}}{{this}}{{#unless @last}}, {{/unless}}{{else}}{{localize "CMET.AbilityDa.Summary.None"}}{{/each}}</p></div><div><strong>{{localize "CMET.AbilityDa.Editor.Persistence"}}</strong><p>{{durationLabel}}</p></div></div>
          {{/if}}
        {{/if}}
      </article>
    {{else}}<p class="cmet-da-empty">{{localize "CMET.AbilityDa.EmptyEffects"}}</p>{{/each}}
  </section>

  <section class="tab cmet-da-tab {{tabs.narrativa.cssClass}}" data-group="primary" data-tab="narrativa">
    {{#if isEditMode}}<div class="cmet-da-narrative-grid"><label>{{localize "CMET.AbilityDa.Fields.Description"}}<textarea name="system.description">{{item.system.description}}</textarea></label><label>{{localize "CMET.AbilityDa.Fields.Functioning"}}<textarea name="system.functioning">{{item.system.functioning}}</textarea></label><label>{{localize "CMET.AbilityDa.Fields.GmNotes"}}<textarea name="system.gmNotes">{{item.system.gmNotes}}</textarea></label><label>{{localize "CMET.AbilityDa.Fields.ManualResolution"}}<textarea name="system.manualResolution">{{item.system.manualResolution}}</textarea></label></div>{{else}}<article class="cmet-da-narrative-view"><h2>{{item.name}}</h2><div><h3>{{localize "CMET.AbilityDa.Fields.Description"}}</h3><p>{{item.system.description}}</p></div><div><h3>{{localize "CMET.AbilityDa.Fields.Functioning"}}</h3><p>{{item.system.functioning}}</p></div><div><h3>{{localize "CMET.AbilityDa.Fields.ManualResolution"}}</h3><p>{{item.system.manualResolution}}</p></div></article>{{/if}}
  </section>

  <section class="tab cmet-da-tab {{tabs.avancado.cssClass}}" data-group="primary" data-tab="avancado">
    <section class="cmet-da-panel cmet-da-advanced"><h2>{{localize "CMET.AbilityDa.Tabs.Advanced"}}</h2><p>{{localize "CMET.AbilityDa.Advanced.ReadOnly"}}</p><dl><dt>UUID</dt><dd>{{item.uuid}}</dd><dt>Item ID</dt><dd>{{item.id}}</dd></dl><pre>{{advancedJson}}</pre></section>
  </section>
</form>
