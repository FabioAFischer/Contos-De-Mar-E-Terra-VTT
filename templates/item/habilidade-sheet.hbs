<form class="cmet-configured-item-sheet" autocomplete="off">
  <div class="cmet-config-chrome">
    <header class="cmet-config-header">
      <img class="cmet-config-header__image" src="{{item.img}}" alt="{{item.name}}" data-action="editImage" data-edit="img" title="{{localize 'CMET.Actions.ChangeImage'}}" aria-label="{{localize 'CMET.Actions.ChangeImage'}}: {{item.name}}" />
      <div class="cmet-config-header__identity">
        <input class="cmet-config-header__name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'CMET.Fields.Name'}}" />
        <label>{{localize "CMET.Ability.Fields.Category"}}<select name="system.category"><option value="">{{localize "CMET.Ability.Fields.NoCategory"}}</option>{{#each categories}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label>{{localize "CMET.Ability.Fields.RollSkill"}}<select name="system.rollSkill"><option value="">{{localize "CMET.Ability.Fields.NoRollSkill"}}</option>{{#each skillGroups}}<optgroup label="{{label}}">{{#each skills}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}</select></label>
        <label>{{localize "CMET.Ability.Fields.Cost"}}<input name="system.cost" type="number" min="0" step="1" value="{{system.cost}}" /></label>
      </div>
    </header>
    <nav class="cmet-config-tabs tabs" data-group="primary" aria-label="{{localize 'CMET.Navigation.Label'}}">
      <button type="button" class="item {{tabs.configuracao.cssClass}}" data-group="primary" data-tab="configuracao">{{localize "CMET.Weapon.Tabs.Configuration"}}</button>
      <button type="button" class="item {{tabs.descricao.cssClass}}" data-group="primary" data-tab="descricao">{{localize "CMET.Weapon.Tabs.Description"}}</button>
    </nav>
  </div>
  <section class="tab cmet-config-tab {{tabs.configuracao.cssClass}}" data-group="primary" data-tab="configuracao">
    <section class="cmet-config-section cmet-ability-fields">
      <label>{{localize "CMET.Ability.Fields.Path"}}<input name="system.path" type="text" value="{{system.path}}" /></label>
      <label>{{localize "CMET.Ability.Fields.Requirements"}}<textarea name="system.requirements">{{system.requirements}}</textarea></label>
    </section>
  </section>
  <section class="tab cmet-config-tab cmet-config-tab--description cmet-ability-description {{tabs.descricao.cssClass}}" data-group="primary" data-tab="descricao">
    <label>{{localize "CMET.Ability.Fields.Description"}}<textarea name="system.description">{{system.description}}</textarea></label>
    <label>{{localize "CMET.Ability.Fields.Effect"}}<textarea name="system.effect">{{system.effect}}</textarea></label>
    <label>{{localize "CMET.Ability.Fields.Upgrade"}}<textarea name="system.upgrade">{{system.upgrade}}</textarea></label>
  </section>
</form>
